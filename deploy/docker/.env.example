# Copy to .env and fill in real values — docker-compose.yml refuses to
# start any service that reads an unset variable here.

# Exact signed release image. Never use a floating tag.
WHYMISS_IMAGE=

# Beacon node REST API, reachable from inside the compose network.
# Use the host's LAN/VPN address, not 127.0.0.1 — that resolves to the
# whymiss container itself, not your host.
BEACON_API=

# Optional consensus-client Prometheus endpoint. Supplies measured block-arrival
# timing and Engine-call durations, which is what the local-layer causes
# (local.cl_slow, local.el_slow, local.vc_*) are attributed from. Without it the
# collector still records duties, but no timing-based cause can be named.
# Peer count no longer comes from here — it is read from the standardised
# /eth/v1/node/peer_count endpoint (ADR-0023).
CL_METRICS_API=

# Optional independent same-chain node used to distinguish network-wide block
# lateness from local propagation — the product's central question.
#
# The beacon API alone is enough: any second node you can reach works, and its
# block arrival is polled from /eth/v1/beacon/headers/{slot} at 500ms resolution
# (ADR-0025). Add the metrics endpoint only when that node is yours, for a
# millisecond-precise measurement instead.
BASELINE_BEACON_API=
BASELINE_METRICS_API=

# Validator indices to track duties for, comma-separated (whymiss's
# --validator-index flag accepts a repeated or comma-separated list).
VALIDATOR_INDICES=

# NTP endpoint used to prove clock trust. This is explicit UDP egress; choose
# one operated by you or a provider you trust. Without it, timing attribution
# deliberately degrades to unknown.insufficient_data.
NTP_SERVER=

# Grafana admin password. Pick your own — there is no default.
GRAFANA_ADMIN_PASSWORD=
