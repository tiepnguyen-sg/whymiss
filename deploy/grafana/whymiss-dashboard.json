{
  "title": "whymiss — validator duty causes",
  "uid": "whymiss-duty-causes",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "tags": ["whymiss", "ethereum", "validator"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Missed / degraded duties by cause",
      "description": "Alert on causes, not symptoms (BUILD_PROMPT.md §12.2). Excludes outcome=\"ok\" — this panel is for duties that actually lost reward, broken down by whymiss's root-cause attribution.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (cause) (rate(whymiss_duty_verdicts_total{outcome=~\"missed|degraded\"}[$__rate_interval]))",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Total duties by outcome",
      "description": "The high-level split: ok, degraded, missed, no_duty. A rising \"missed\"/\"degraded\" share is the first thing worth noticing before drilling into cause.",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum by (outcome) (whymiss_duty_verdicts_total)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cause breakdown (all time, current window)",
      "description": "Raw counts per cause since this whymiss process started — a quick \"what's actually been happening\" table, not a rate.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 16, "x": 8, "y": 9 },
      "targets": [
        {
          "expr": "sum by (cause) (whymiss_duty_verdicts_total)",
          "legendFormat": "{{cause}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 4,
      "title": "Missed or degraded duties (last hour)",
      "description": "A single stat for a status-panel/alert-adjacent glance: how many duties lost reward recently.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "sum(increase(whymiss_duty_verdicts_total{outcome=~\"missed|degraded\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
