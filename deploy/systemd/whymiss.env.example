# Install to /etc/whymiss/whymiss.env (mode 0600, root-owned — this file
# has no secrets whymiss itself needs, but keep the convention anyway).
#
#   sudo install -d -m 0755 /etc/whymiss
#   sudo install -m 0600 deploy/systemd/whymiss.env.example /etc/whymiss/whymiss.env
#   sudo $EDITOR /etc/whymiss/whymiss.env
#   sudo install -m 0644 deploy/systemd/whymiss.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now whymiss

# Beacon node REST API.
BEACON_API=http://127.0.0.1:5052

# Validator indices to track duties for, comma-separated.
VALIDATOR_INDICES=24,187

# Address to serve Prometheus metrics on. 127.0.0.1-bound by default —
# widen only if Prometheus scrapes from another host (I-4: no egress by
# default).
METRICS_ADDR=127.0.0.1:9101
