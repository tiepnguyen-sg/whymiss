# Install to /etc/whymiss/whymiss.env (mode 0600, root-owned — this file
# has no secrets whymiss itself needs, but keep the convention anyway).
#
#   sudo install -d -m 0755 /etc/whymiss
#   sudo install -m 0600 deploy/systemd/whymiss.env.example /etc/whymiss/whymiss.env
#   sudo $EDITOR /etc/whymiss/whymiss.env
#   sudo install -m 0644 deploy/systemd/whymiss.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now whymiss

# Beacon node REST API. Required; set this before starting the service.
WHYMISS_BEACON_API=

# Optional consensus-client Prometheus endpoint for peer-count corroboration.
WHYMISS_CL_METRICS_API=

# Optional independent same-chain node used to distinguish network-wide block
# lateness from local propagation. Set both or leave both empty.
WHYMISS_BASELINE_BEACON_API=
WHYMISS_BASELINE_METRICS_API=

# Validator indices to track duties for, comma-separated. Required.
WHYMISS_VALIDATOR_INDICES=

# Explicitly configured NTP endpoint used to prove clock trust. Required for
# timing attribution; leave empty only if unknown timing verdicts are acceptable.
WHYMISS_NTP_SERVERS=

# Address to serve Prometheus metrics on. 127.0.0.1-bound by default —
# widen only if Prometheus scrapes from another host (I-4: no egress by
# default).
WHYMISS_METRICS_ADDR=127.0.0.1:9101
